# Webex Integration — https://developer.webex.com (Create an Integration)
WEBEX_CLIENT_ID=
WEBEX_CLIENT_SECRET=
# Must match a redirect URI on the integration (e.g. http://localhost:3000/webex/callback)
WEBEX_REDIRECT_URI=http://localhost:3000/webex/callback

# Public URL Webex POSTs to when OOO webhooks fire (must match a route on this app)
# Local: use ngrok or similar for Webex to reach your machine
WEBEX_WEBHOOK_TARGET_URL=http://localhost:3000/webhooks/messages
# Optional: HMAC secret for X-Spark-Signature verification (same value on both webhooks if set)
WEBEX_WEBHOOK_SECRET=
# Local JSON state (user token + webhook metadata)
WEBEX_STATE_PATH=./data/state.json

PORT=3000
LOG_LEVEL=info
