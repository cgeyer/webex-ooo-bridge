# Webex Integration (https://developer.webex.com — Create an Integration)
WEBEX_CLIENT_ID=
WEBEX_CLIENT_SECRET=
# Must match a redirect URI registered on the integration (e.g. https://your-host/webex/callback)
WEBEX_REDIRECT_URI=http://localhost:3000/webex/callback
# Public base URL of this service (for OAuth and webhook callback URLs)
PUBLIC_BASE_URL=http://localhost:3000

# Microsoft Entra (Azure AD) app — for Microsoft Graph: MailboxSettings.Read (delegated)
# https://learn.microsoft.com/en-us/graph/api/resources/mailboxsettings
MS_CLIENT_ID=
MS_CLIENT_SECRET=
MS_TENANT=common
MS_REDIRECT_URI=http://localhost:3000/ms/callback

# 32-byte key, base64 — encrypts stored OAuth refresh tokens in SQLite
# node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
ENCRYPTION_KEY=

# lowdb JSON file (swap for PostgreSQL when you need multi-instance or scale)
DATABASE_PATH=./data/app.json

# Optional: Webex incoming webhook / signature validation
WEBEX_WEBHOOK_SECRET=

# Port for the HTTP server
PORT=3000
LOG_LEVEL=info
