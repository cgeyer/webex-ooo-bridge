# Webex Integration — https://developer.webex.com (Create an Integration)
WEBEX_CLIENT_ID=
WEBEX_CLIENT_SECRET=
# Must match a redirect URI on the integration (e.g. http://localhost:3000/webex/callback)
WEBEX_REDIRECT_URI=http://localhost:3000/webex/callback

# Public URL Webex POSTs to when OOO webhooks fire (must match a route on this app)
# Local: use ngrok or similar for Webex to reach your machine
WEBEX_WEBHOOK_TARGET_URL=http://localhost:3000/webhooks/messages
# Optional: HMAC secret for X-Spark-Signature verification (same value on both webhooks if set)
WEBEX_WEBHOOK_SECRET=
# Bot access token for absence notifications (Create a Message as the bot)
WEBEX_BOT_TOKEN=
# Bot email address — direct messages from this sender are ignored (avoids notification loops)
WEBEX_BOT_EMAIL=

# Local SQLite database (user preferences + encrypted OAuth tokens)
DB_PATH=./data/app.db
# 32-byte key for AES-256-GCM token encryption (generate: openssl rand -base64 32)
ENCRYPTION_KEY=
# Session signing secret (generate: openssl rand -hex 32)
SESSION_SECRET=
# Set true when serving over HTTPS in production
SECURE_COOKIES=false

PORT=3000
# IP address (or hostname) to bind the HTTP server (e.g. 127.0.0.1 for localhost only, 0.0.0.0 for all interfaces)
LISTEN_HOST=0.0.0.0
LOG_LEVEL=info
